{
  "name": "co-engram",
  "private": true,
  "version": "0.0.0",
  "description": "Co-Engram: 协同进化的团队记忆系统（host-agnostic 核心 + OpenClaw / Claude Code 双宿主适配器）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm verify:i18n-dist",
    "test": "pnpm -r --filter './packages/**' test",
    "test:contracts": "pnpm --filter @co-engram/contracts-test test",
    "typecheck": "pnpm -r --filter './packages/**' exec tsc --noEmit",
    "format": "pnpm exec prettier --write '**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml}'",
    "format:check": "pnpm exec prettier --check '**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml}'",
    "lint:finding-refs": "node scripts/lint-no-finding-refs.mjs",
    "audit:defaults": "node scripts/audit-hardcoded-defaults.mjs",
    "verify:i18n-dist": "node scripts/verify-i18n-dist.mjs",
    "deploy:openclaw": "node scripts/deploy-co-engram.mjs",
    "deploy:openclaw:dry": "node scripts/deploy-co-engram.mjs --no-restart",
    "deploy:cli-global": "node scripts/deploy-co-engram.mjs --cli-global --no-restart"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
