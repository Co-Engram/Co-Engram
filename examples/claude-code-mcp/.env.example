# Required
CO_ENGRAM_DATA_ROOT=/absolute/path/to/team-memory

# Recommended
CO_ENGRAM_DEFAULT_CREATED_BY=your-username

# Maintenance engine (optional)
CO_ENGRAM_MAINTENANCE=1
CO_ENGRAM_MAINTENANCE_ENABLED_STAGES=light,deep,rem
CO_ENGRAM_MAINTENANCE_LIGHT_INTERVAL_MS=300000
CO_ENGRAM_MAINTENANCE_DEEP_INTERVAL_MS=3600000
CO_ENGRAM_MAINTENANCE_REM_INTERVAL_MS=604800000
CO_ENGRAM_MAINTENANCE_LEARNING_RATE=0.1
